{
  "configVersion": "v3",
  "app": {
    "appId": 1128132,
    "appName": "RunRadar",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "RunRadar",
    "description": "Telemetría deportiva y pulso en tiempo real para corredores y grupos de running."
  },
  "permissions": [
    "device:os.bg_service",
    "data:user.hd.heart_rate",
    "data:user.hd.step",
    "data:user.hd.calorie",
    "device:os.vibrate",
    "device:os.local_storage"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0.0",
      "target": "3.0.0",
      "minVersion": "3.0"
    }
  },
  "targets": {
    "common": {
      "module": {
        "page": {
          "pages": [
            "page/index"
          ]
        },
        "app-service": {
          "services": [
            "app-service/run_radar_service"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "st": "r"
        },
        {
          "st": "s"
        }
      ],
      "designWidth": 480
    }
  },
  "i18n": {
    "es-ES": {
      "appName": "RunRadar"
    },
    "en-US": {
      "appName": "RunRadar"
    }
  },
  "defaultLanguage": "es-ES"
}
